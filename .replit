modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "development"
BACKEND_PORT = "3001"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node backend/src/server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"
